# Copiar a .env (direnv lo carga solo; .env no se commitea)
AUTH0_ISSUER_URI=https://<tenant>.auth0.com/
AUTH0_AUDIENCE=https://snippet-searcher/api
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/snippet
DB_USER=snippet
DB_PASSWORD=snippet
PERMISSION_SERVICE_URL=http://localhost:8081
RUNNER_URL=http://localhost:8082
ASSET_SERVICE_URL=http://localhost:8083
REDIS_HOST=localhost
REDIS_PORT=6379

# Management API de Auth0 (app machine-to-machine con read:users)
AUTH0_DOMAIN=<tenant>.auth0.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Token client credentials para las llamadas sin usuario (app machine-to-machine autorizada en la API)
# AUTH0_TOKEN_URI=https://<tenant>.auth0.com/oauth/token   # por defecto ${AUTH0_ISSUER_URI}oauth/token
AUTH0_SERVICE_CLIENT_ID=
AUTH0_SERVICE_CLIENT_SECRET=

WS_ALLOWED_ORIGINS=*

# Observabilidad: logs legibles en local; New Relic apagado hasta tener la license key
LOG_FORMAT=plain
METRICS_PORT=9464
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
